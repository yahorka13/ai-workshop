{
  "name": "ui",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "contracts": "bun tooling/contracts.ts check",
    "contracts:generate": "bun tooling/contracts.ts generate",
    "lint": "bun --bun eslint . --max-warnings 0 && bun --bun prettier . --check",
    "format": "bun --bun prettier . --write",
    "typecheck": "bun --bun tsc --noEmit",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test ./tests/integration --timeout 30000",
    "coverage": "bun tooling/coverage.ts",
    "mutate": "bun tooling/mutate.ts",
    "mutate:stryker": "stryker run --testRunner bun",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "story-ids": "bun tooling/story-ids.ts",
    "duplicates": "bun --bun jscpd --config .jscpd.json || { echo 'duplicates: extract the shared code into one function or module and import it from both places; a clone that must stay goes between // jscpd:ignore-start <reason> and // jscpd:ignore-end, with bin/duplicate-disables.txt raised'; exit 1; }",
    "unused": "bun --bun knip --config knip.config.ts --no-progress || { echo 'unused: delete it or stop exporting it; when it is used in a way the checker cannot see, mark it knipignore with a reason and raise bin/unused-disables.txt'; exit 1; }",
    "imports": "bun --bun depcruise src tests tooling --config .dependency-cruiser.mjs --output-type err-long || { echo 'imports: fix each import as its rule says; a one-off that must stay is a pathNot entry on that rule with // import-exception: <reason>, and bin/import-disables.txt raised'; exit 1; }"
  },
  "dependencies": {
    "@apollo/client": "4.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "i18next": "26.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.17",
    "react-is": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/client-preset": "6.2.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@happy-dom/global-registrator": "21.0.1",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@stryker-mutator/core": "10.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
